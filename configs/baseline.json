{
  "_comment": "Full CourtVisionNet method. Run: python -m src.training.train --config configs/baseline.json --set seed=0",
  "name": "baseline",
  "seed": 42,
  "deterministic": false,
  "manifest": "data/colab_data_v2/manifest.json",
  "train_split": "train",
  "val_split": "val",
  "images_dir": "",
  "train_annotations": "data/colab_data/train/annotations",
  "val_annotations": "data/colab_data/valid/annotations",
  "train_images": "data/colab_data/train/images",
  "val_images": "data/colab_data/valid/images",
  "exclude_sources": [],
  "val_exclude_sources": [
    "blender"
  ],
  "canonicalize_labels": true,
  "sigma": 2.0,
  "line_thickness": 5,
  "in_channels": 7,
  "num_keypoints": 30,
  "image_size": 640,
  "heatmap_size": 160,
  "pretrained": true,
  "batch_size": 8,
  "num_epochs": 100,
  "learning_rate": 0.0001,
  "head_lr_mult": 10.0,
  "weight_decay": 0.0001,
  "scheduler": "cosine",
  "warmup_epochs": 1.0,
  "min_lr_ratio": 0.01,
  "freeze_backbone_epochs": 5,
  "grad_clip": 1.0,
  "amp": false,
  "ema": false,
  "ema_decay": 0.999,
  "seg_weight": 1.0,
  "heatmap_weight": 1.0,
  "offset_weight": 5.0,
  "vis_weight": 0.5,
  "reproj_weight": 0.01,
  "heatmap_loss": "js",
  "symmetric_loss": true,
  "select_metric": "val_pck10",
  "patience": 15,
  "checkpoint_dir": "checkpoints/{name}_s{seed}",
  "save_every": 10,
  "log_interval": 10,
  "num_workers": 0
}
